{
  "name": "@digimmo/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "scripts": {
    "prepare": "tsup",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": { "zod": "^4.0.0" },
  "devDependencies": { "@eslint/js": "^9.18.0", "eslint": "^9.18.0", "typescript-eslint": "^8.20.0", "@vitest/coverage-v8": "^3.2.7", "tsup": "^8.0.0", "typescript": "^5.6.0", "vitest": "^3.0.0" }
}
